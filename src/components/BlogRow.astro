---
import type {CollectionEntry} from 'astro:content'
import LedgerRow from '@/components/LedgerRow.astro'

type Props = {post: CollectionEntry<'blog'>}
const {post} = Astro.props
const href = `/blog/${post.id.replace(/\.mdx?$/, '')}/`
---

<LedgerRow>
  <div slot='label'>
    <p class='ledger-meta'>
      <time datetime={post.data.publishedDate.toISOString()}
        >{post.data.publishedDate.toLocaleDateString('en', {month: 'short', day: 'numeric', year: 'numeric'})}</time>
    </p>
    <p class='ledger-meta'>{post.data.readingTime}</p>
    {post.data.draft && <span class='draft-label'>draft outline</span>}
  </div>
  <h3 class='blog-title'><a href={href}>{post.data.title}</a></h3>
  <p>{post.data.description}</p>
  <p class='ledger-stack'>{post.data.tags.join(' · ')}</p>
</LedgerRow>

<style>
  .blog-title {
    margin: 0;
    font-size: var(--text-lg);
    line-height: var(--leading-body);
    letter-spacing: var(--tracking-display);
  }
</style>
