---
import AccentPicker from '@/components/AccentPicker.astro'
import ThemeToggle from '@/components/ThemeToggle.astro'
import {navigation, site} from '@/data/site'

const currentPath = Astro.url.pathname
function isCurrent(href: string) {
  if (href === '/') return currentPath === '/'
  return currentPath.startsWith(href)
}
---

<header class="site-header">
  <div class="masthead-shell">
    <a class="masthead-brand" href="/" aria-label="Avi Charlop home">
      <span class="masthead-name">{site.name}</span>
      <span class="masthead-role">{site.role}</span>
    </a>
    {/* One list for every width: a row in the band on desktop, a ruled panel under it on mobile (CSS switches). */}
    <nav class="site-nav" id="mobile-panel" aria-label="Primary navigation" data-mobile-panel>
      {
        navigation.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="nav-actions">
      <AccentPicker />
      <ThemeToggle />
      <button
        class="menu-toggle"
        type="button"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="mobile-panel"
        data-menu-toggle
      >
        <span class="burger" aria-hidden="true"><i></i><i></i><i></i></span>
      </button>
    </div>
  </div>
</header>

<script>
  // Delegated so the listener survives view-transition swaps of the header.
  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) return
    const menuToggle = event.target.closest('[data-menu-toggle]')
    if (!menuToggle) return
    const mobilePanel = document.querySelector('[data-mobile-panel]')
    const nextState = menuToggle.getAttribute('aria-expanded') !== 'true'
    menuToggle.setAttribute('aria-expanded', String(nextState))
    if (nextState) {
      mobilePanel?.setAttribute('data-open', '')
    } else {
      mobilePanel?.removeAttribute('data-open')
    }
  })
</script>
