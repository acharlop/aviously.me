---
import type {CollectionEntry} from 'astro:content'
import LedgerRow from '@/components/LedgerRow.astro'

type Props = {
  project: CollectionEntry<'projects'>
}

const {project} = Astro.props
const href = `/work/${project.id.replace(/\.mdx?$/, '')}/`
---

<LedgerRow label={project.data.title} href={href} sub={project.data.type} meta={project.data.dates}>
  <p>{project.data.summary}</p>
  {project.data.stack.length > 0 && <p class='ledger-stack'>{project.data.stack.slice(0, 5).join(' · ')}</p>}
</LedgerRow>
