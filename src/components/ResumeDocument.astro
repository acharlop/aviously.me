---
// Print-first resume document. One layout for /resume and the PDF.
// Screen and print share the same grid; only sizes change.
import {resumeCredits, resumeSkillLines, formatDates} from '@/lib/resume-document'
import {shapeResume} from '@/lib/resume-export'
import {defaultResumeOptions, type ResumeOptions} from '@/data/resume-options'
import {site} from '@/data/site'

type Props = {
  options?: ResumeOptions
  /** Short blurb under the name. Defaults to the site tagline. */
  summary?: string
}

const {options = defaultResumeOptions, summary = site.tagline} = Astro.props
const {experience, education} = shapeResume(options)
const skillLines = resumeSkillLines()
const creditLines = resumeCredits(education)

const contact = [
  {label: site.email, href: `mailto:${site.email}`},
  {label: site.url.replace('https://', ''), href: site.url},
  {label: site.linkedin.replace('https://', ''), href: site.linkedin},
  {label: site.github.replace('https://', ''), href: site.github},
]
---

<article class="resume-doc">
  <header class="resume-head">
    <div>
      <h1>{site.name}</h1>
      <p class="summary">{summary}</p>
    </div>
    <address class="contact">
      <span>{site.location}</span>
      {contact.map((item) => <a href={item.href}>{item.label}</a>)}
    </address>
  </header>

  <section class="resume-section">
    <div class="rule"><h2>Experience</h2></div>
    <div class="roles">
      {
        experience.map((item) => (
          <article class="role">
            <h3>
              <strong>{item.company.replace(/\s*\(.*\)$/, '')}</strong>
              <span> — {[item.role, item.location].filter(Boolean).join(', ')}</span>
            </h3>
            <span class="dates">{formatDates(item.dates)}</span>
            <ul>
              {item.bullets.map((bullet) => (
                <li>{bullet}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </section>

  <section class="resume-section resume-footer">
    <div class="rule"><h2>Skills, open source and education</h2></div>
    <div class="credit-grid">
      <div class="credit-col">
        {
          skillLines.map((line) => (
            <p>
              <strong>{line.label}</strong> — {line.value}
            </p>
          ))
        }
      </div>
      <div class="credit-col">
        {
          creditLines.map((line) => (
            <p>
              <strong>{line.label}</strong> — {line.value}
            </p>
          ))
        }
      </div>
    </div>
  </section>
</article>

<style>
  .resume-doc {
    /* Follow the site theme so the document stays legible on the dark palette.
       Print is unaffected: global.css forces the light palette inside
       @media print, which is where these resolve to ink on white. */
    --resume-ink: var(--text);
    --resume-muted: var(--muted);
    --resume-accent: var(--accent);
    --resume-date-col: 132px;

    display: flex;
    flex-direction: column;
    gap: 14px;
    line-height: 1.42;
    text-wrap: pretty;
  }

  .resume-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 26px;
  }

  .resume-head h1 {
    margin: 0;
    font-family: 'Cal Sans', system-ui, sans-serif;
    font-weight: 600;
    line-height: 1;
    color: var(--resume-ink);
  }

  .summary {
    margin: 9px 0 0;
    max-width: 47ch;
  }

  .contact {
    display: grid;
    justify-items: end;
    font-style: normal;
    color: var(--resume-muted);
    line-height: 1.75;
    white-space: nowrap;
  }

  .contact a {
    color: inherit;
    text-decoration: none;
  }

  .contact a:hover {
    text-decoration: underline;
  }

  .rule {
    border-top: 1.5px solid var(--resume-ink);
    padding-top: 5px;
    margin-bottom: 9px;
  }

  .rule h2 {
    margin: 0;
    font-size: 0.82em;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--resume-accent);
  }

  .roles {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  /* Title left, dates in their own right-hand column so every date aligns. */
  .role {
    display: grid;
    grid-template-columns: 1fr var(--resume-date-col);
    gap: 0 20px;
    break-inside: avoid;
    orphans: 3;
    widows: 3;
  }

  .role h3 {
    margin: 0;
    font-size: 1.05em;
    font-weight: 400;
  }

  .role h3 strong {
    font-weight: 800;
  }

  .role h3 span {
    color: var(--resume-muted);
  }

  .dates {
    color: var(--resume-muted);
    text-align: right;
    white-space: nowrap;
  }

  /* Tailwind's preflight strips list markers globally, so the resume asks for
     discs back. `outside` positioning gives the hanging indent: wrapped lines
     align to the text, not under the marker. */
  .role ul {
    grid-column: 1 / -1;
    margin: 3px 0 0;
    padding-left: 15px;
    list-style: disc outside;
  }

  .role li {
    margin-top: 1.5px;
  }

  .role li::marker {
    color: var(--resume-muted);
  }

  /* Pushed to the bottom of the page by the auto margin (see the print rules). */
  .resume-footer {
    break-inside: avoid;
    margin-top: auto;
  }

  .credit-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 9px 26px;
  }

  .credit-col {
    display: grid;
    gap: 2px;
    align-content: start;
  }

  .credit-col p {
    margin: 0;
  }

  @media (max-width: 640px) {
    .resume-head,
    .role,
    .credit-grid {
      display: block;
    }

    .dates {
      display: block;
      text-align: left;
    }

    .contact {
      justify-items: start;
      margin-top: 10px;
    }

    .credit-col + .credit-col {
      margin-top: 9px;
    }
  }

  /* The whole document scales from one font-size at print. */
  @media print {
    /* Letter (11in) minus the 0.5in print margins, less a little slack so
       sub-pixel rounding can't tip the last line onto a second page. Filling
       the page height is what lets .resume-footer's auto margin bottom-align it. */
    .resume-doc {
      font-size: 10px;
      min-height: 9.9in;
    }

    .resume-head h1 {
      font-size: 36px;
    }

    .summary {
      font-size: 11px;
    }

    .contact {
      font-size: 9.5px;
      padding-top: 4px;
    }

    .dates {
      font-size: 10px;
    }

    .role h3 {
      font-size: 11.5px;
    }

    .rule h2 {
      font-size: 9.5px;
    }
  }
</style>
