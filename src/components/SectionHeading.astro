---
// Compatibility wrapper: about, experience and open-source still import this.
// It renders a SectionBar chip from the old kicker and keeps the title, text
// and link, so those pages pick up the ledger look until their own tickets
// move them to SectionBar directly (#49 deletes this file).
import SectionBar from '@/components/SectionBar.astro'

type Props = {
  kicker: string
  title: string
  text?: string
  href?: string
  linkLabel?: string
}

const {kicker, title, text, href, linkLabel} = Astro.props
const link = href && linkLabel ? {href, label: linkLabel} : undefined
---

<SectionBar label={kicker.replace(/_/g, ' ')} as="div">
  {link && <a slot="note" href={link.href}>{link.label}</a>}
</SectionBar>
<h2 class="ledger-headline">{title}</h2>
{text && <p class="ledger-summary">{text}</p>}
