---
// Minimal shell for the private /app learning area. Deliberately excludes the
// portfolio Header/Footer, analytics, and SEO/JSON-LD, and is marked noindex —
// this area is private and must never be indexed or appear in the sitemap.
// The app draws its own ink band header (src/components/app/AppHeader.tsx);
// #49 can swap it for the shared masthead once #41 lands.
import ThemeInit from '@/components/ThemeInit.astro'
import '@/styles/global.css'

type Props = {title?: string}
const {title = 'Learning'} = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · aviously</title>
    <link rel="icon" href="/favicon.png" />
    <ThemeInit />
  </head>
  <body>
    <slot />
  </body>
</html>
