---
import Layout from '@/components/Layout.astro'
import SocialLinks from '@/components/SocialLinks.astro'
---

<Layout title="Page not found - Avi Charlop" description="That page does not exist on aviously.me.">
  <section class="shell page-hero">
    <p class="meta-label">404</p>
    <h1>That page isn’t in the ledger.</h1>
    <p class="lead">The link may be old, or the address has a typo. Everything worth reading is one step away.</p>
    <div class="hero-actions">
      <a class="button" href="/">Back home</a>
      <a class="button secondary" href="/work/">See the work</a>
      <a class="button secondary" href="/contact/">Get in touch</a>
    </div>
    <SocialLinks />
  </section>
</Layout>
