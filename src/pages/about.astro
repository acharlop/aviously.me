---
import Layout from '@/components/Layout.astro'
import LedgerRow from '@/components/LedgerRow.astro'
import SectionBar from '@/components/SectionBar.astro'
import SocialLinks from '@/components/SocialLinks.astro'
import {resumeSheet} from '@/data/resume-sheet'
import {site} from '@/data/site'

// The long-form intro lives in site.ts so LinkedIn and this page share one text.
// Only the first two paragraphs are the approach; the third is LinkedIn's
// sign-off (AI tooling, "open to roles"), and the AI part has its own section below.
const aboutParagraphs = site.about.split('\n\n').slice(0, 2)
---

<Layout
  title='About Avi Charlop - Senior Full-Stack Engineer'
  description="Avi Charlop's professional story, working style, and engineering strengths."
>
  <section class='shell page-hero'>
    <h1>Greenfield products, and the teams and tooling that keep them running.</h1>
    <p class='lead'>
      I’m a senior full-stack engineer and team lead with 10 years of shipping across startups, communications
      platforms, fintech, commerce, Web3, AI tools, and enterprise SaaS.
    </p>
    <SocialLinks />
  </section>

  <section class='shell ledger-section'>
    <SectionBar label='About' as='h2' />
    <div class='ledger-rows'>
      <LedgerRow label='approach'>{aboutParagraphs.map((paragraph) => <p>{paragraph}</p>)}</LedgerRow>
      <LedgerRow label='strengths'>
        <p>
          Turning ambiguous product goals into shipped systems, hiring and leading distributed teams, working directly with
          sales, product, and design, modernizing legacy systems while delivery continues, and building reusable UI and
          platform foundations.
        </p>
      </LedgerRow>
    </div>
  </section>

  <section class='shell ledger-section'>
    <SectionBar label='AI engineering' as='h2'>
      <Fragment slot='note'>{resumeSheet.ai.tools}</Fragment>
    </SectionBar>
    <div class='ledger-rows'>
      {
        resumeSheet.ai.rows.map((row) => (
          <LedgerRow label={row.label}>
            <p>{row.text}</p>
          </LedgerRow>
        ))
      }
    </div>
  </section>

  <section class='shell ledger-section'>
    <SectionBar label='How I work' as='h2' />
    <div class='ledger-rows'>
      <LedgerRow label='principles'>
        <ul class='ledger-list'>
          {
            [
              'Start with the user and business constraint',
              'Ship small, useful increments',
              'Make systems easier for the next engineer',
              'Mentor engineers into owning features end to end',
              'Prefer typed, tested, observable paths',
              'Keep design and engineering close',
            ].map((item) => <li>{item}</li>)
          }
        </ul>
      </LedgerRow>
    </div>
  </section>
</Layout>
