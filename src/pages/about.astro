---
import Layout from '@/components/Layout.astro'
import LedgerRow from '@/components/LedgerRow.astro'
import SectionBar from '@/components/SectionBar.astro'
import SocialLinks from '@/components/SocialLinks.astro'
---

<Layout
  title='About Avi Charlop - Senior Full-Stack Engineer'
  description="Avi Charlop's professional story, working style, and engineering strengths."
>
  <section class='shell page-hero'>
    <p class='eyebrow'>`about`</p>
    <h1>Product-minded engineering, from interface craft to infrastructure reality.</h1>
    <p class='lead'>
      I’m a senior full-stack engineer who has spent more than a decade building product experiences across startups,
      communications platforms, fintech, commerce, Web3, AI tools, and enterprise SaaS.
    </p>
    <SocialLinks />
  </section>

  <section class='shell ledger-section'>
    <SectionBar label='About' as='h2' />
    <div class='ledger-rows'>
      <LedgerRow label='approach'>
        <p>
          He combines frontend craft with backend fluency, infrastructure awareness, and team leadership. The work often
          starts with ambiguity: a customer need, a legacy system, an internal workflow, or a product idea that has to become
          something real without slowing the team down.
        </p>
        <p>
          His strengths are turning ambiguous product goals into shipped systems, leading distributed teams, working directly
          with sales, product, and design, modernizing legacy systems while delivery continues, and building reusable UI and
          platform foundations.
        </p>
      </LedgerRow>
    </div>
  </section>

  <section class='shell ledger-section'>
    <SectionBar label='How I work' as='h2' />
    <div class='ledger-rows'>
      <LedgerRow label='principles'>
        <ul class='ledger-list'>
          {
            [
              'Start with the user and business constraint',
              'Ship small, useful increments',
              'Make systems easier for the next engineer',
              'Prefer typed, tested, observable paths',
              'Keep design and engineering close',
              'Learning new ways not to do things every day',
            ].map((item) => <li>{item}</li>)
          }
        </ul>
      </LedgerRow>
    </div>
  </section>
</Layout>
