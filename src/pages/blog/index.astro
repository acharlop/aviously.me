---
import {getCollection} from 'astro:content'
import BlogRow from '@/components/BlogRow.astro'
import LedgerRow from '@/components/LedgerRow.astro'
import SectionBar from '@/components/SectionBar.astro'
import Layout from '@/components/Layout.astro'
import {slugify} from '@/lib/slugs'

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf())
const tags = Array.from(new Set(posts.flatMap((post) => post.data.tags))).sort()
---

<Layout title='Blog - Avi Charlop' description='Technical writing from Avi Charlop.'>
  <section class='shell page-hero'>
    <h1>Writing</h1>
    <p class='lead'>
      Long-form notes on modernization, frontend architecture, type-safe systems, product engineering, infrastructure, and
      developer experience.
    </p>
  </section>

  <section class='shell ledger-section'>
    <SectionBar label='Posts' />
    {
      posts.length > 0 ? (
        <>
          <nav class='blog-filter' aria-label='Blog tags'>
            <a href='/blog/' aria-current='page'>
              All
            </a>
            {tags.map((tag) => (
              <a href={`/blog/tags/${slugify(tag)}/`}>{tag}</a>
            ))}
          </nav>
          <div class='ledger-rows'>
            {posts.map((post) => (
              <BlogRow post={post} />
            ))}
          </div>
        </>
      ) : (
        <div class='ledger-rows'>
          <LedgerRow label='status' sub='in draft'>
            <p>
              The first posts are being written. Until they land, the <a href='/work/'>case studies</a> carry the
              long-form thinking, and the <a href='/rss.xml'>RSS feed</a> is already live.
            </p>
          </LedgerRow>
        </div>
      )
    }
  </section>
</Layout>
