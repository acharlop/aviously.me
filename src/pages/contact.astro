---
import ExternalLink from '@/components/ExternalLink.astro'
import Layout from '@/components/Layout.astro'
import SectionBar from '@/components/SectionBar.astro'
import SocialLinks from '@/components/SocialLinks.astro'
import {site} from '@/data/site'

const turnstileSiteKey = import.meta.env.CF_TURNSTILE_SITE_KEY
---

<Layout
  title='Contact Avi Charlop'
  description='Contact Avi Charlop for senior engineering, frontend architecture, full-stack product, team lead, and consulting conversations.'
>
  <section class='shell page-hero'>
    <h1>Let’s talk about the product or platform challenge in front of you.</h1>
    <p class='lead'>
      I’m interested in senior engineering, team lead, frontend architecture, full-stack product, and consulting
      conversations.
    </p>
    <SocialLinks />
  </section>

  <section class='shell ledger-section contact-section'>
    <SectionBar label='Contact' as='h2' />
    <div class='contact-grid'>
      <div>
        <p class='form-notice form-notice--success' data-form-success hidden aria-live='polite'>
          Thanks — your message is on its way. I’ll get back to you by email.
        </p>
        <p class='form-notice form-notice--error' data-form-error hidden aria-live='polite'>
          Something went wrong sending your message. Please try again, or email me directly below.
        </p>
        <p class='form-notice form-notice--submitting' data-form-submitting hidden aria-live='polite'>
          Sending your message…
        </p>
        <p class='form-notice form-notice--error' data-form-invalid hidden aria-live='polite'>
          Please fill in your name, a valid email address, and a message.
        </p>
        <p class='form-notice form-notice--error' data-form-captcha hidden aria-live='polite'>
          Please complete the verification check before sending.
        </p>
        {
          !turnstileSiteKey && (
            <p class='form-notice form-notice--error' data-form-unconfigured aria-live='polite'>
              The form is offline because spam protection isn’t configured. Email me directly instead.
            </p>
          )
        }
        <form
          class='contact-form'
          action='/api/contact'
          method='post'
          novalidate
          data-turnstile={turnstileSiteKey ? 'ready' : 'missing'}
        >
          <input type='text' name='_honey' style='display:none' tabindex='-1' autocomplete='off' />
          <label>
            Name
            <input name='name' autocomplete='name' required />
          </label>
          <label>
            Email
            <input name='email' type='email' autocomplete='email' required />
          </label>
          <label>
            Message
            <textarea name='message' required></textarea>
          </label>
          {turnstileSiteKey && <div class='cf-turnstile' data-sitekey={turnstileSiteKey} data-theme='auto' />}
          <button class='button contact-submit' type='submit' disabled={!turnstileSiteKey}>
            Send message
          </button>
        </form>
      </div>
      <aside class='contact-direct'>
        <SectionBar label='Direct' as='h3' />
        <div class='contact-direct-body'>
          <h2>Email is best.</h2>
          <p>No phone number is published here by default. Email, LinkedIn, and GitHub are the primary contact paths.</p>
          <div class='button-row'>
            <a class='button' href={`mailto:${site.email}`}>{site.email}</a>
            <ExternalLink class='button outline' href={site.linkedin}>LinkedIn</ExternalLink>
            <ExternalLink class='button outline' href={site.github}>GitHub</ExternalLink>
          </div>
        </div>
      </aside>
    </div>
  </section>
  {turnstileSiteKey && <script is:inline src='https://challenges.cloudflare.com/turnstile/v0/api.js' async defer />}
  <script is:inline data-astro-rerun>
    const contactParams = new URLSearchParams(location.search)
    if (contactParams.get('sent') === 'true') {
      document.querySelector('[data-form-success]')?.removeAttribute('hidden')
    }
    if (contactParams.get('error')) {
      document.querySelector('[data-form-error]')?.removeAttribute('hidden')
    }

    const contactForm = document.querySelector('form.contact-form')
    const markValidity = () => {
      let valid = true
      contactForm.querySelectorAll('[required]').forEach((field) => {
        const ok = field.checkValidity()
        field.setAttribute('aria-invalid', String(!ok))
        if (!ok) valid = false
      })
      document.querySelector('[data-form-invalid]')?.toggleAttribute('hidden', valid)
      return valid
    }
    contactForm?.addEventListener('submit', (event) => {
      const form = event.currentTarget
      if (!(form instanceof HTMLFormElement)) return
      if (!markValidity()) {
        event.preventDefault()
        form.querySelector('[aria-invalid="true"]')?.focus()
        return
      }
      // Never post without a solved Turnstile challenge: the API rejects it anyway,
      // but a round-trip to an error page is a worse experience than a notice here.
      const captchaToken = form.querySelector('[name="cf-turnstile-response"]')?.value
      const captchaNotice = document.querySelector('[data-form-captcha]')
      if (form.dataset.turnstile !== 'ready' || !captchaToken) {
        event.preventDefault()
        captchaNotice?.removeAttribute('hidden')
        return
      }
      captchaNotice?.setAttribute('hidden', '')
      form.querySelector('button[type="submit"]')?.setAttribute('disabled', '')
      document.querySelector('[data-form-submitting]')?.removeAttribute('hidden')
    })
    contactForm?.addEventListener('input', (event) => {
      if (event.target.getAttribute('aria-invalid') === 'true' && event.target.checkValidity()) {
        event.target.setAttribute('aria-invalid', 'false')
      }
    })
  </script>
</Layout>
