---
import Layout from '@/components/Layout.astro'
import LedgerRow from '@/components/LedgerRow.astro'
import SectionBar from '@/components/SectionBar.astro'
import TriangleList from '@/components/TriangleList.astro'
import {education, experience} from '@/data/experience'
---

<Layout
  title='Experience - Avi Charlop'
  description='Resume-style timeline for Avi Charlop, senior full-stack engineer and team lead.'
>
  <section class='shell page-hero'>
    <p class='eyebrow'>`experience`</p>
    <h1>A timeline of product systems, modernization, and team leadership.</h1>
    <p class='lead'>
      Canonical resume data for recent roles, selected freelance work, education, and long-running platform experience.
    </p>
  </section>

  <section class='shell ledger-section' aria-label='Professional experience'>
    <SectionBar label='Experience' as='div' />
    <h2 class='ledger-headline'>Professional experience</h2>
    <div class='ledger-rows experience-rows'>
      {
        experience.map((item) => (
          <LedgerRow
            label={item.company}
            sub={item.role}
            meta={item.location ? `${item.dates} · ${item.location}` : item.dates}
          >
            {item.summary && <p>{item.summary}</p>}
            {item.bullets.length > 0 && <TriangleList items={item.bullets} />}
            {item.subRoles && item.subRoles.length > 0 && (
              <div class='experience-subroles'>
                {item.subRoles.map((subRole) => (
                  <LedgerRow class='experience-subrole' label={subRole.role} meta={subRole.dates}>
                    <TriangleList items={subRole.bullets} />
                    {subRole.tech && <p class='ledger-stack'>{subRole.tech}</p>}
                  </LedgerRow>
                ))}
              </div>
            )}
          </LedgerRow>
        ))
      }
    </div>
  </section>

  <section class='shell ledger-section' aria-label='Education'>
    <SectionBar label='Education' />
    <div class='ledger-rows'>
      {
        education.map((item) => (
          <LedgerRow label={item.school} sub={item.location} meta={item.dates}>
            <p>{item.description}</p>
          </LedgerRow>
        ))
      }
    </div>
  </section>
</Layout>

<style>
  .experience-subroles {
    margin-top: calc(4 * var(--ledger-unit));
  }

  .experience-subroles :global(.ledger-row) {
    border-top: var(--rule);
  }

  .experience-subroles :global(.ledger-row:first-child) {
    padding-top: calc(5 * var(--ledger-unit));
  }
</style>
