---
import AvailabilityBadge from '@/components/AvailabilityBadge.astro'
import ExternalLink from '@/components/ExternalLink.astro'
import LedgerRow from '@/components/LedgerRow.astro'
import Layout from '@/components/Layout.astro'
import SectionBar from '@/components/SectionBar.astro'
import SocialLinks from '@/components/SocialLinks.astro'
import {openSourceRepos} from '@/data/open-source'
import {resumeSheet} from '@/data/resume-sheet'
import {site} from '@/data/site'

// Same credit line as the resume sheet, so the two never drift.
const openSourceCredit = resumeSheet.credits.find((row) => row.label === 'Open source')?.text
---

<Layout title='Open Source - Avi Charlop' description='Open source profile and featured repositories from Avi Charlop.'>
  <section class='shell page-hero'>
    <h1>Open source as a place to sharpen tools and leave useful trails.</h1>
    <p class='lead'>Building in the open on GitHub since 2014. Avi Charlop / {site.githubHandle}.</p>
    <SocialLinks />
  </section>

  <section class='shell ledger-section'>
    <SectionBar label='Open source' as='h2' />
    <div class='ledger-rows'>
      <LedgerRow label='profile'>
        <AvailabilityBadge />
        <p>{openSourceCredit}</p>
        <p><ExternalLink class='button outline' href={site.github}>See more on GitHub</ExternalLink></p>
      </LedgerRow>
    </div>
  </section>

  <section class='shell ledger-section'>
    <SectionBar label='Repos' as='h2' />
    <h2 class='ledger-headline'>Featured open source</h2>
    <div class='ledger-rows'>
      {
        openSourceRepos.map((repo) => (
          <LedgerRow label={repo.name} href={repo.href} sub={repo.type} meta={repo.status}>
            <p>{repo.summary}</p>
            <p>
              <strong>{repo.role}</strong>
              {repo.note ? ` · ${repo.note}` : ''}
            </p>
            {repo.stack.length > 0 && <p class='ledger-stack'>{repo.stack.join(', ')}</p>}
          </LedgerRow>
        ))
      }
    </div>
  </section>
</Layout>
