---
// Local-only preview of the resume sheet in each accent variant
// (src/data/resume-sheet.ts). Dynamic route with an empty getStaticPaths in
// production, so `astro build` emits nothing: the page exists on `astro dev`
// only, at /resume/preview-<slug>. scripts/make-resume-pdf.ts prints variants
// from this route when passed --view and --out.
//
// TODO: once tailored resumes need sharing by link, promote this to a public
// page behind the same Convex auth the private /app area uses.
import Layout from '@/components/Layout.astro'
import ResumeSheet from '@/components/ResumeSheet.astro'
import {resumeSheetVariants} from '@/data/resume-sheet'

// Hoisted by Astro: may only reference imports, not the frontmatter above.
export function getStaticPaths() {
  if (!import.meta.env.DEV) return []
  return Object.keys(resumeSheetVariants).map((slug) => ({params: {view: `preview-${slug}`}}))
}

const slug = (Astro.params.view as string).replace(/^preview-/, '')
const variant = resumeSheetVariants[slug]
---

<Layout title="Resume sheet preview (local)" description="Local-only preview of the resume sheet accent variants.">
  <section class="shell page-hero print-hidden">
    <p class="eyebrow">`local only`</p>
    <h1>Resume sheet — {variant.label}</h1>
    <p class="lead">Not built or deployed. Print this page to check the PDF layout.</p>
    <div class="button-row">
      <button class="button secondary" type="button" onclick="window.print()">Print this page</button>
      {
        Object.entries(resumeSheetVariants).map(([key, v]) => (
          <a class="button secondary" href={`/resume/preview-${key}`}>
            {v.label}
          </a>
        ))
      }
    </div>
  </section>

  <section class="shell section resume-shell">
    <ResumeSheet accent={variant.accent} />
  </section>
</Layout>
