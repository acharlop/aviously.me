---
import {getCollection, render} from 'astro:content'
import ExternalLink from '@/components/ExternalLink.astro'
import LedgerRow from '@/components/LedgerRow.astro'
import Layout from '@/components/Layout.astro'
import SectionBar from '@/components/SectionBar.astro'

export async function getStaticPaths() {
  const projects = await getCollection('projects')
  return projects.map((project) => ({
    params: {slug: project.id.replace(/\.mdx?$/, '')},
    props: {project},
  }))
}

const {project} = Astro.props
const {Content} = await render(project)
---

<Layout
  title={`${project.data.title} - Avi Charlop`}
  description={project.data.summary}
  canonical={`/work/${project.id.replace(/\.mdx?$/, '')}/`}
>
  <section class='shell page-hero'>
    <h1>{project.data.title}</h1>
    <p class='lead'>{project.data.summary}</p>
  </section>

  <section class='shell section case-study'>
    <article class='case-study-main'>
      <SectionBar label='Case study' as='h2' />
      <div class='ledger-rows'>
        <LedgerRow label='Problem'>
          <p>{project.data.problem}</p>
        </LedgerRow>
        <LedgerRow label='Role'>
          <p>{project.data.role}</p>
        </LedgerRow>
        <LedgerRow label='What Avi built'>
          <p>{project.data.contribution}</p>
        </LedgerRow>
        <LedgerRow label='Outcome'>
          <p>{project.data.outcome}</p>
        </LedgerRow>
      </div>
      <div class='case-body prose'>
        <Content />
      </div>
    </article>
    <aside class='case-sidebar'>
      <SectionBar label='Details' as='h2' />
      <div class='ledger-rows'>
        <LedgerRow label='Type'>
          <p>{project.data.type}</p>
        </LedgerRow>
        {
          project.data.dates && (
            <LedgerRow label='Dates'>
              <p>{project.data.dates}</p>
            </LedgerRow>
          )
        }
        {
          project.data.stack.length > 0 && (
            <LedgerRow label='Stack'>
              <p class='ledger-stack'>{project.data.stack.join(' · ')}</p>
            </LedgerRow>
          )
        }
        {
          project.data.links.map((link) => (
            <LedgerRow label={link.label}>
              <ExternalLink class='case-link' href={link.href}>{new URL(link.href).hostname}</ExternalLink>
            </LedgerRow>
          ))
        }
      </div>
    </aside>
  </section>
</Layout>

<style>
  .case-sidebar :global(.ledger-row) {
    grid-template-columns: minmax(0, 1fr);
    row-gap: calc(3 * var(--ledger-unit));
  }
</style>
